<!DOCTYPE html>
<html lang="pl">
<head>
  <meta charset="UTF-8" />
  <title>Wesołych Świąt!</title>
  <style>
    body {
      background-color: #fff7f0;
      font-family: 'Comic Sans MS', cursive;
      text-align: center;
      padding: 30px;
      color: #444;
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
      margin: 0;
    }

    h1 {
      color: #ff6f91;
    }

    .decor {
      font-size: 26px;
      margin: 10px 0;
    }

    .bunny-box {
      display: flex;
      justify-content: center;
      margin: 20px 0;
    }

    .bunny {
      font-family: monospace;
      font-size: 18px;
      background: #fff;
      border: 2px dashed #ff6f91;
      border-radius: 15px;
      padding: 10px 25px;
      white-space: pre;
      line-height: 1.3;
      box-shadow: 2px 2px 10px rgba(0,0,0,0.05);
      display: none;
      animation: dance 1s infinite alternate; /* Dodajemy animację do króliczka */
    }

    /* Animacja tańca */
    @keyframes dance {
      0% {
        transform: rotate(0deg);
      }
      50% {
        transform: rotate(15deg);
      }
      100% {
        transform: rotate(0deg);
      }
    }

    .message {
      background: #ffe0e9;
      border-radius: 15px;
      padding: 20px;
      margin-top: 20px;
      display: inline-block;
      box-shadow: 0 0 8px #ffb3c6;
      max-width: 400px;
      display: none;
    }

    .footer {
      margin-top: 30px;
      font-size: 14px;
      color: #999;
    }

    .photo-box {
      margin-top: 25px;
    }

    .photo-box img {
      max-width: 300px;
      border-radius: 12px;
      box-shadow: 0 0 8px #aaa;
    }

    .label {
      font-size: 14px;
      margin-bottom: 8px;
      color: #666;
    }

    .flower {
      position: absolute;
      font-size: 30px;
      animation: fall 6s linear infinite;
      z-index: 0;
    }

    @keyframes fall {
      0% { top: -60px; opacity: 0; }
      10% { opacity: 1; }
      100% { top: 110%; opacity: 0; }
    }

    #click-btn {
      background-color: #ff6f91;
      color: white;
      padding: 15px 30px;
      border-radius: 10px;
      cursor: pointer;
      font-size: 20px;
      border: none;
      margin-top: 20px;
      transition: background-color 0.3s ease;
    }

    #click-btn:hover {
      background-color: #ff4d6a;
    }

  </style>
</head>
<body>

  <!-- Przycisk "Otwórz" -->
  <button id="click-btn">Otwórz</button>

  <div id="page-content" style="display: none;">
    <!-- Spadające emotki -->
    <span class="flower" style="left: 10%; animation-delay: 0s;">🌸</span>
    <span class="flower" style="left: 30%; animation-delay: 2s;">🥚</span>
    <span class="flower" style="left: 50%; animation-delay: 4s;">🌼</span>
    <span class="flower" style="left: 70%; animation-delay: 6s;">🌷</span>
    <span class="flower" style="left: 90%; animation-delay: 8s;">🌸</span>

    <div class="decor">🌸 🥚 🌼 🥚 🌷</div>

    <h1>Wesołych Świąt, Aniu!</h1>

    <div class="bunny-box">
      <div class="bunny" id="bunny">
(\_/)<br>
( •_• )<br>
/ >♥< \
      </div>
    </div>

    <div class="decor">🌷 🥚 🌼 🥚 🌸</div>

    <div class="message">
      <p>Kochana Aniu,<br>
      Życzę Ci cudownej Wielkanocy, pełnej radości, słodyczy i… zero bugów!</p>
      <p>Dziękuję, że jesteś – jesteś jak kod bez błędów: rzadkość i skarb!</p>
    </div>

    <div class="photo-box">
      <div class="label">Twoje wielkanocne zdjęcie:</div>
      <img src="https://i.imgur.com/kQ2HdiM.jpg" alt="Zdjęcie wielkanocne">
    </div>

    <div class="footer">
      Ten kod z czekoladą został wygenerowany specjalnie dla Ciebie.
    </div>
  </div>

  <script>
    // Po kliknięciu przycisku "Otwórz"
    document.getElementById('click-btn').onclick = function() {
      // Ukrywamy przycisk
      document.getElementById('click-btn').style.display = 'none';

      // Pokazujemy całą zawartość strony
      document.getElementById('page-content').style.display = 'block';

      // Pokazujemy króliczka
      var bunny = document.getElementById('bunny');
      bunny.style.display = 'block';

      // Uruchamiamy tańczenie króliczka
      bunny.classList.add('dance');

      // Po 2 sekundach (czas trwania tańca) pokazujemy życzenia
      setTimeout(function() {
        document.querySelector('.message').style.display = 'inline-block';
      }, 2000);
    };
  </script>

</body>
</html>
